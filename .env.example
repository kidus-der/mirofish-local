# MiroFish, fully local fork. Copy to .env. Nothing here needs an account or API key.
# The network guard (backend/netguard.py) refuses every non-loopback connection, so these
# must point at this machine. This file does not download any model.

# --- LLM: any OpenAI-compatible server on this machine (Ollama, llama.cpp server, LM Studio, vLLM) ---
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:11435/v1   # scripts/serve-ollama.sh
LLM_MODEL_NAME=mirofish-qwen            # qwen3.5:9b tuned by ollama/Modelfile
LLM_REASONING_EFFORT=none               # set to "low" etc. to let Qwen think (much slower)

# --- Embeddings for graph search (hybrid graph search) ---
EMBED_MODEL_NAME=qwen3-embedding:0.6b
EMBED_BASE_URL=http://127.0.0.1:11435/v1

# --- Optional second endpoint used by the simulation scripts (also must be local) ---
# LLM_BOOST_API_KEY=local
# LLM_BOOST_BASE_URL=http://127.0.0.1:11435/v1
# LLM_BOOST_MODEL_NAME=mirofish-qwen

# --- Tuning ---
# GRAPH_INGESTION_TIMEOUT_SECONDS=7200   # local extraction is slow; raise for big documents
# NETGUARD_ALLOW=gpu-box.lan             # let ONE named LAN host through. Default: none.
# NETGUARD=off                           # only while downloading models by hand; then remove

# --- Simulation against a local model ---
SIM_LLM_CONCURRENCY=2   # keep equal to OLLAMA_NUM_PARALLEL
MODEL_TIMEOUT=1800
