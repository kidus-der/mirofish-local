    "initial_posts": [
      {
        "content": "We cannot raise rates by 9% while forcing cuts to our maintenance teams. If this plan passes without a guarantee on our jobs, we will have no choice but to strike. The union stands with the workers.",
        "poster_agent_id": 2,
        "poster_name": "Samuel Adeyemi",
        "poster_type": "Organization"
      },
      {
        "content": "The proposed 9% tariff is a lifeline for our aging pipes, but we must ensure the Coastal Infrastructure Bank loan covers the costs without further burdening low-income families. We are committed to transparency.",
        "poster_agent_id": 18,
        "poster_name": "Nadia Okafor",
        "poster_type": "Organization"
      },
      {
        "content": "Renters in the Eastside district already pay more per litre than homeowners due to broken shared meters. We demand an end to this inequality before any tariff increase is approved.",
        "poster_agent_id": 17,
        "poster_name": "Priya Raman",
        "poster_type": "Organization"
      },
      {
        "content": "An investigation reveals that Brightline Consulting, owned by the chief executive's brother, likely broke procurement rules. The public has a right to know the full story behind the $4.2 million study fee.",
        "poster_agent_id": 0,
        "poster_name": "Lena Fischer",
        "poster_type": "Journalist"
